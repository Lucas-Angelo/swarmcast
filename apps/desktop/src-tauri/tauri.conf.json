{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SwarmCast",
  "version": "../package.json",
  "identifier": "io.github.lucas-angelo.swarmcast",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "appimage"],
    "publisher": "Lucas Angelo",
    "copyright": "© Lucas Angelo. MIT License.",
    "category": "Video",
    "shortDescription": "Members-only live streaming from your computer",
    "longDescription": "SwarmCast streams from OBS to a private link for your members, from your own computer, with optional viewer-to-viewer sharing.",
    "homepage": "https://github.com/Lucas-Angelo/swarmcast",
    "license": "MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "PortugueseBR"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.5",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"],
        "section": "video"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0RDFCQUNGNTUzMzk2MjQKUldRa2xqTlZ6N3JSNUtxTkhKTG0yWDRmWVdRWEtUWU9zQWJnOEJUK2MxSURTT0RjSzV3MnpHU0cK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
