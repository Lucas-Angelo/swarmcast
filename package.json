{
  "name": "swarmcast",
  "version": "0.2.1",
  "private": true,
  "description": "Self-hosted, members-only live streaming with optional viewer P2P.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @swarmcast/shared && npm run build -w @swarmcast/viewer && npm run build -w @swarmcast/admin && npm run build -w @swarmcast/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "dev": "npm run dev -w @swarmcast/server",
    "package": "node scripts/build/package.mjs",
    "fetch-bins": "node scripts/build/fetch-binaries.mjs",
    "desktop:build": "node scripts/build/desktop.mjs",
    "desktop:dev": "node apps/desktop/test/dev.mjs",
    "desktop:test": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "desktop:manifest": "node scripts/build/updater-manifest.mjs",
    "desktop:icons": "node apps/desktop/icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@yao-pkg/pkg": "^6.24.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsqr": "^1.4.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "ip": "$ip"
  },
  "dependencies": {
    "ip": "file:apps/server/shims/ip"
  }
}
