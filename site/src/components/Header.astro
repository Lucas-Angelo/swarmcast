---
// Starlight's header plus a language link that stays visible on phones (Starlight moves its
// language menu into the hamburger menu below 50rem).
import Default from '@astrojs/starlight/components/Header.astro';
import { otherLangPath, siteLang, tr } from '../lib/i18n';

const lang = siteLang(Astro.locals.starlightRoute.locale);
const other = otherLangPath(Astro.url.pathname);
---

<div class="sc-header">
  <div class="sc-header-main"><Default /></div>
  <a
    class="sc-lang-mobile"
    href={other.href}
    hreflang={other.lang}
    lang={other.lang}
    aria-label={tr(lang, 'lang.switch.label')}
    data-testid="lang-mobile"
  >
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"></path></svg>
    <span>{lang === 'en' ? 'PT' : 'EN'}</span>
  </a>
</div>

<style>
  .sc-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 100%;
  }
  .sc-header-main {
    flex: 1;
    min-width: 0;
    height: 100%;
  }
  .sc-lang-mobile {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4rem;
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .sc-lang-mobile:hover {
    border-color: var(--sl-color-accent);
  }
  @media (min-width: 50rem) {
    .sc-lang-mobile {
      display: none;
    }
  }
</style>
