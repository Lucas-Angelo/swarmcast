---
// The hero's download block: ONE button for the visitor's system, one muted meta line (version ·
// size · system), one line of quiet links, one trust line. Without JavaScript the button opens
// the download page. In the browser it detects Windows / macOS / Linux and, when the site's
// stats.json lists the installers of the latest release, links straight to the right file.
// Phones get "SwarmCast runs on your computer" with Copy link / Share instead.
import Icon from './Icon.astro';
import { links } from '../brand.mjs';
import { BASE, pagePath, tr, ui, type SiteLang } from '../lib/i18n';

interface Props {
  lang: SiteLang;
}
const { lang } = Astro.props;
const strings = ui[lang];
const installPage = {
  windows: pagePath(lang, 'install/windows'),
  macos: pagePath(lang, 'install/macos'),
  linux: pagePath(lang, 'install/linux'),
};
const downloadPage = pagePath(lang, 'download');
---

<div
  class="sc-dl"
  data-testid="download"
  data-lang={lang}
  data-releases={links.releases}
  data-stats={`${BASE}/stats.json`}
  data-strings={JSON.stringify(strings)}
  data-install={JSON.stringify(installPage)}
>
  <a class="sc-btn sc-btn-primary sc-btn-lg sc-dl-main" href={downloadPage} data-testid="download-main">
    <Icon name="download" size={18} />
    <span data-label>{tr(lang, 'dl.button')}</span>
  </a>
  <p class="sc-dl-meta" data-testid="download-meta" hidden></p>
  <p class="sc-dl-links" data-testid="download-other">
    <span class="sc-dl-alt" data-testid="download-alt" hidden></span>
    <a class="sc-link sc-link-muted" href={downloadPage} data-testid="download-other-link">{tr(lang, 'dl.other')}</a>
    <a class="sc-link sc-link-muted" href={pagePath(lang, 'download')} data-testid="download-howto" hidden>{tr(lang, 'dl.howTo')}</a>
  </p>

  <div class="sc-dl-mobile" data-testid="download-mobile" hidden>
    <p class="sc-dl-mobile-title">{tr(lang, 'dl.mobile.title')}</p>
    <p class="sc-dl-mobile-text">{tr(lang, 'dl.mobile')}</p>
    <div class="sc-dl-mobile-actions">
      <button type="button" class="sc-btn sc-btn-primary" data-copy data-testid="download-copy">
        <Icon name="copy" size={18} />
        <span data-copy-label>{tr(lang, 'dl.copy')}</span>
      </button>
      <button type="button" class="sc-btn sc-btn-secondary" data-share data-testid="download-share" hidden>
        <Icon name="share" size={18} />
        {tr(lang, 'dl.share')}
      </button>
    </div>
    <span class="sc-sr-only" role="status" aria-live="polite" data-copy-status></span>
  </div>

  <p class="sc-dl-trust">{tr(lang, 'dl.trust')}</p>
</div>

<script>
  import { choicesFor, detectOs, formatSize, type Choice } from '../lib/download';
  import { loadUsage } from '../lib/stats';
  import type { SiteLang } from '../lib/i18n';

  type Strings = Record<string, string>;

  for (const root of document.querySelectorAll<HTMLElement>('.sc-dl')) {
    const s = JSON.parse(root.dataset.strings ?? '{}') as Strings;
    const lang = (root.dataset.lang ?? 'en') as SiteLang;
    const install = JSON.parse(root.dataset.install ?? '{}') as Record<string, string>;
    const releases = root.dataset.releases ?? '';
    const main = root.querySelector<HTMLAnchorElement>('.sc-dl-main')!;
    const label = main.querySelector<HTMLElement>('[data-label]')!;
    const meta = root.querySelector<HTMLElement>('.sc-dl-meta')!;
    const linksRow = root.querySelector<HTMLElement>('.sc-dl-links')!;
    const alt = root.querySelector<HTMLElement>('.sc-dl-alt')!;
    const howTo = root.querySelector<HTMLAnchorElement>('[data-testid="download-howto"]')!;
    const mobile = root.querySelector<HTMLElement>('.sc-dl-mobile')!;
    const os = detectOs(navigator as Navigator & { userAgentData?: { platform?: string; mobile?: boolean } });
    root.dataset.os = os;

    if (os === 'mobile') {
      main.hidden = true;
      mobile.hidden = false;
      linksRow.classList.add('is-mobile');
      const copyBtn = mobile.querySelector<HTMLButtonElement>('[data-copy]')!;
      const copyLabel = mobile.querySelector<HTMLElement>('[data-copy-label]')!;
      const status = mobile.querySelector<HTMLElement>('[data-copy-status]')!;
      const shareBtn = mobile.querySelector<HTMLButtonElement>('[data-share]')!;
      const url = location.href.split('#')[0];
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(url);
          copyLabel.textContent = s['dl.copied'] ?? '';
          status.textContent = s['dl.copied'] ?? '';
          setTimeout(() => (copyLabel.textContent = s['dl.copy'] ?? ''), 2500);
        } catch {
          window.prompt('', url);
        }
      });
      if (typeof navigator.share === 'function') {
        shareBtn.hidden = false;
        shareBtn.addEventListener('click', () => {
          navigator.share({ title: s['dl.shareTitle'], url }).catch(() => {});
        });
      }
    }

    const render = (latest: Parameters<typeof choicesFor>[1], version?: string) => {
      const { primary, alternatives } = choicesFor(os, latest, releases);
      if (!primary) return;
      const c: Choice = primary;
      main.href = c.href;
      main.dataset.direct = String(c.direct);
      label.textContent = s[`dl.for.${c.key}`] ?? s['dl.button'] ?? '';
      const parts = [version ? (s['dl.version'] ?? '').replace('{version}', version) : '', c.size ? formatSize(c.size, lang) : '', s[`dl.note.${c.key}`] ?? ''];
      meta.textContent = parts.filter(Boolean).join(' · ');
      meta.hidden = false;
      alt.textContent = '';
      for (const a of alternatives) {
        const link = document.createElement('a');
        link.href = a.href;
        link.className = 'sc-link sc-link-muted';
        link.textContent = s[`dl.alt.${a.key}`] ?? a.key;
        link.dataset.testid = `download-alt-${a.key}`;
        alt.append(link);
      }
      alt.hidden = alternatives.length === 0;
      howTo.href = install[c.os] ?? howTo.href;
      howTo.hidden = false;
    };

    render(null);
    void loadUsage(root.dataset.stats ?? '').then((u) => {
      if (u.latest) render(u.latest, u.latest.version);
    });
  }
</script>

<style>
  .sc-dl {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }
  .sc-dl-main {
    min-width: 15rem;
    max-width: 100%;
  }
  .sc-dl p {
    margin: 0;
  }
  .sc-dl-meta {
    color: var(--sc-muted);
    font-size: var(--sc-text-small);
    font-variant-numeric: tabular-nums;
  }
  .sc-dl-meta[hidden],
  .sc-dl-alt[hidden],
  .sc-dl-mobile[hidden],
  .sc-dl [hidden] {
    display: none;
  }
  .sc-dl-links,
  .sc-dl-alt {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    column-gap: 1rem;
    row-gap: 0.25rem;
    font-size: var(--sc-text-small);
  }
  .sc-dl-links {
    margin-top: 0.25rem;
  }
  /* A quiet dot between the links that are shown. */
  .sc-dl-links > :not([hidden]) ~ :not([hidden])::before,
  .sc-dl-alt > a + a::before {
    content: '·';
    margin-inline: 0.625rem;
    color: var(--sc-muted);
  }
  .sc-dl-links {
    column-gap: 0;
  }
  .sc-dl-links.is-mobile {
    order: 3;
  }
  .sc-dl-mobile {
    order: 2;
  }
  .sc-dl-trust {
    order: 4;
  }
  .sc-dl-trust {
    margin-top: 0.75rem !important;
    color: var(--sc-muted);
    font-size: var(--sc-text-micro);
    letter-spacing: 0.01em;
  }
  .sc-dl-mobile {
    display: grid;
    gap: 0.5rem;
    justify-items: center;
    width: 100%;
    max-width: 24rem;
    padding: 1.25rem;
    border: 1px solid var(--sc-border);
    border-radius: var(--sc-radius-lg);
    background: var(--sc-surface);
  }
  .sc-dl-mobile-title {
    color: var(--sc-ink);
    font-weight: 600;
  }
  .sc-dl-mobile-text {
    color: var(--sc-muted);
    font-size: var(--sc-text-small);
  }
  .sc-dl-mobile-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
</style>
