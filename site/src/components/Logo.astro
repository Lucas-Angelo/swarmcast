---
// The SwarmCast logo: mark + wordmark. Driven by `brand.logo` in src/brand.mjs; until the real
// files exist, a placeholder geometric mark (a honey hexagon cell with a play triangle) next to
// the name set in the display font (--sc-font-display, Fredoka).
import { brand } from '../brand.mjs';

interface Props {
  /** Small label after the wordmark, e.g. "Guide" in the docs header. */
  suffix?: string;
  size?: 'md' | 'lg';
}
const { suffix, size = 'md' } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../../../assets/brand/*.{svg,png,webp}', { eager: true });
const file = (name: string | undefined) => (name ? files[`../../../assets/brand/${name}`]?.default : undefined);
const full = file(brand.logo?.full);
const fullDark = file(brand.logo?.fullDark);
const mark = file(brand.logo?.mark);
const markPx = size === 'lg' ? 28 : 24;
---

<span class:list={['sc-logo', `sc-logo-${size}`]}>
  {
    full ? (
      <>
        <img class:list={['sc-logo-full', { 'sc-logo-light': fullDark }]} src={full.src} alt={brand.logo?.alt ?? brand.name} height={markPx} />
        {fullDark && <img class="sc-logo-full sc-logo-dark" src={fullDark.src} alt={brand.logo?.alt ?? brand.name} height={markPx} />}
      </>
    ) : (
      <>
        {mark ? (
          <img class="sc-logo-mark" src={mark.src} alt="" width={markPx} height={markPx} />
        ) : (
          <svg class="sc-logo-mark" width={markPx} height={markPx} viewBox="0 0 24 24" aria-hidden="true" data-testid="logo-placeholder">
            <path d="M12 2.2 20.5 7.1v9.8L12 21.8 3.5 16.9V7.1z" fill="var(--sc-secondary)" stroke="var(--sc-secondary)" stroke-width="1.6" stroke-linejoin="round" />
            <path d="M10 8.6v6.8l5.6-3.4z" fill="var(--sc-on-secondary)" stroke="var(--sc-on-secondary)" stroke-width="1" stroke-linejoin="round" />
          </svg>
        )}
        <span class="sc-logo-word" translate="no">{brand.name}</span>
      </>
    )
  }
  {suffix && <span class="sc-logo-suffix">{suffix}</span>}
</span>

<style>
  .sc-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    color: var(--sc-ink);
    line-height: 1;
  }
  .sc-logo-mark {
    flex: none;
    display: block;
  }
  .sc-logo-word {
    font-family: var(--sc-font);
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .sc-logo-lg .sc-logo-word {
    font-size: 1.375rem;
  }
  .sc-logo-full {
    display: block;
    width: auto;
  }
  :global(:root[data-theme='dark']) .sc-logo-light,
  :global(:root:not([data-theme='dark'])) .sc-logo-dark {
    display: none;
  }
  .sc-logo-suffix {
    padding-inline-start: 0.625rem;
    margin-inline-start: 0.125rem;
    border-inline-start: 1px solid var(--sc-border-strong);
    color: var(--sc-muted);
    font-family: var(--sc-font-text);
    font-size: 0.9375rem;
    font-weight: 500;
    white-space: nowrap;
  }
</style>
