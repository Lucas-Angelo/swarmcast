---
// The home page, in one language. Sections: hero (one download button), product screenshot,
// how it works, features, trust + usage numbers + honest limits, questions, closing call.
import DownloadButton from './DownloadButton.astro';
import Frame from './Frame.astro';
import HowItWorks from './HowItWorks.astro';
import Icon from './Icon.astro';
import Mascot from './Mascot.astro';
import UsageStats from './UsageStats.astro';
import { brand } from '../brand.mjs';
import { copy } from '../lib/copy';
import { pagePath, tr, type SiteLang } from '../lib/i18n';
import panelEn from '../../../docs/img/panel-overview-en.png';
import panelPt from '../../../docs/img/panel-overview-pt-BR.png';

interface Props {
  lang: SiteLang;
}
const { lang } = Astro.props;
const c = copy[lang];
const href = (h: string) => (h.startsWith('http') ? h : pagePath(lang, h));
---

<section class="sc-hero">
  <div class="sc-container sc-hero-inner">
    {brand.mascot && <div class="sc-hero-mascot"><Mascot lang={lang} width={128} eager /></div>}
    <h1 class="sc-hero-title">{c.hero.title}</h1>
    <p class="sc-hero-lead">{c.hero.lead}</p>
    <DownloadButton lang={lang} />
  </div>
  <div class="sc-hero-band">
    <div class="sc-container sc-hero-shot">
      <Frame src={lang === 'en' ? panelEn : panelPt} alt={c.hero.shotAlt} crop={1280 / 760} eager />
    </div>
  </div>
</section>

<section class="sc-section sc-section-alt sc-how" aria-labelledby="how">
  <div class="sc-container">
    <div class="sc-section-head">
      <h2 class="sc-h2" id="how">{c.how.title}</h2>
      <p class="sc-lead">{c.how.lead}</p>
    </div>
    <HowItWorks lang={lang} />
  </div>
</section>

<section class="sc-section" aria-labelledby="features">
  <div class="sc-container">
    <div class="sc-section-head">
      <h2 class="sc-h2" id="features">{c.features.title}</h2>
      <p class="sc-lead">{c.features.lead}</p>
    </div>
    <ul class="sc-features">
      {
        c.features.items.map((f) => (
          <li>
            <span class="sc-feature-icon">
              <Icon name={f.icon} size={20} />
            </span>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="sc-section sc-section-alt" aria-labelledby="trust">
  <div class="sc-container">
    <div class="sc-section-head">
      <h2 class="sc-h2" id="trust">{c.trust.title}</h2>
      <p class="sc-lead">{c.trust.lead}</p>
    </div>
    <div class="sc-trust">
      <div class="sc-trust-main">
        <ul class="sc-trust-list">
          {
            c.trust.items.map((t) => (
              <li>
                <span class="sc-feature-icon">
                  <Icon name={t.icon} size={20} />
                </span>
                <div>
                  <h3>{t.title}</h3>
                  <p>{t.text}</p>
                  {t.link && (
                    <a class="sc-link" href={href(t.link.href)} rel={t.link.href.startsWith('http') ? 'noopener' : undefined}>
                      {t.link.label}
                      <Icon name="arrow-right" size={14} class="sc-arrow" />
                    </a>
                  )}
                </div>
              </li>
            ))
          }
        </ul>
        <UsageStats lang={lang} />
      </div>
      <aside class="sc-limits" aria-labelledby="limits" data-testid="limits">
        <h3 id="limits">{c.trust.limitsTitle}</h3>
        <ul>
          {c.trust.limits.map((l) => <li>{l}</li>)}
        </ul>
        <a class="sc-link" href={pagePath(lang, 'live/protection')}>
          {c.trust.limitsLink}
          <Icon name="arrow-right" size={14} class="sc-arrow" />
        </a>
      </aside>
    </div>
  </div>
</section>

<section class="sc-section" aria-labelledby="faq">
  <div class="sc-container sc-faq">
    <div class="sc-faq-head">
      <h2 class="sc-h2" id="faq">{c.faq.title}</h2>
      <a class="sc-link" href={pagePath(lang, `help/troubleshooting#${tr(lang, 'anchor.faq')}`)}>
        {c.faq.more}
        <Icon name="arrow-right" size={14} class="sc-arrow" />
      </a>
    </div>
    <div class="sc-faq-list" data-testid="faq">
      {
        c.faq.items.map((q) => (
          <details>
            <summary>
              <span>{q.q}</span>
              <Icon name="chevron" size={18} class="sc-faq-caret" />
            </summary>
            <p>{q.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<section class="sc-section sc-cta" aria-labelledby="cta">
  <div class="sc-container"><hr class="sc-rule" /></div>
  <div class="sc-container sc-cta-inner">
    <h2 class="sc-h2" id="cta">{c.cta.title}</h2>
    <p class="sc-lead">{c.cta.lead}</p>
    <div class="sc-cta-actions">
      <a class="sc-btn sc-btn-primary" href={pagePath(lang, 'download')}>
        <Icon name="download" size={18} />
        {c.cta.download}
      </a>
      <a class="sc-btn sc-btn-secondary" href={pagePath(lang, 'guide')}>{c.cta.guide}</a>
    </div>
  </div>
</section>

<style>
  /* ---------- Hero ---------- */
  .sc-hero {
    padding-top: clamp(2.5rem, 1.5rem + 5vw, 6rem);
    overflow: hidden;
  }
  .sc-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .sc-hero-mascot {
    margin-bottom: 1.5rem;
  }
  .sc-hero-title {
    max-width: 19ch;
    font-size: var(--sc-text-display);
    font-weight: 650;
    line-height: 1.05;
    letter-spacing: -0.04em;
  }
  .sc-hero-lead {
    max-width: 34rem;
    margin: 1.25rem 0 2rem;
    color: var(--sc-muted);
    font-size: var(--sc-text-lead);
    line-height: 1.5;
  }
  .sc-hero-shot {
    max-width: calc(64rem + 2 * var(--sc-gutter));
  }
  /* The screenshot straddles the line where the next (surface) band starts: a hard two-tone
     split, not a visual gradient. */
  .sc-hero-band {
    margin-top: clamp(3rem, 2rem + 4vw, 5rem);
    background: linear-gradient(to bottom, var(--sc-bg) 50%, var(--sc-surface) 50%);
  }
  .sc-how {
    border-top: 0;
  }

  /* ---------- Features ---------- */
  .sc-features {
    display: grid;
    gap: 2.5rem 2rem;
    padding: 0;
    list-style: none;
  }
  .sc-features li,
  .sc-trust-list li {
    display: grid;
    align-content: start;
    gap: 0.5rem;
  }
  .sc-feature-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 0.5rem;
    border-radius: var(--sc-radius);
    background: var(--sc-accent-soft);
    color: var(--sc-accent-strong);
  }
  .sc-features h3,
  .sc-trust-list h3,
  .sc-limits h3 {
    font-size: var(--sc-text-h3);
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  .sc-features p,
  .sc-trust-list p {
    color: var(--sc-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    max-width: 36ch;
  }
  /* Phones: icon on the left, like the steps, so the list stays short. */
  @media (max-width: 39.99rem) {
    .sc-features {
      gap: 1.75rem;
    }
    .sc-features li {
      grid-template-columns: auto 1fr;
      column-gap: 1rem;
      row-gap: 0.25rem;
    }
    .sc-features .sc-feature-icon {
      grid-row: span 2;
      margin: 0;
    }
  }
  @media (min-width: 40rem) {
    .sc-features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .sc-features {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3rem 3rem;
    }
  }

  /* ---------- Trust ---------- */
  .sc-trust {
    display: grid;
    gap: 3rem;
  }
  .sc-trust-main {
    display: grid;
    gap: 3rem;
    align-content: start;
  }
  .sc-trust-list {
    display: grid;
    gap: 2rem;
    padding: 0;
    list-style: none;
  }
  .sc-trust-list li {
    grid-template-columns: auto 1fr;
    gap: 1rem;
  }
  .sc-trust-list li > div {
    display: grid;
    gap: 0.375rem;
    justify-items: start;
  }
  .sc-trust-list .sc-feature-icon {
    margin: 0;
  }
  .sc-trust-list a,
  .sc-limits a,
  .sc-faq-head a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: var(--sc-text-small);
  }
  .sc-limits {
    align-self: start;
    display: grid;
    gap: 1rem;
    align-content: start;
    justify-items: start;
    padding: 1.75rem;
    border: 1px solid var(--sc-border);
    border-radius: var(--sc-radius-lg);
    background: var(--sc-surface);
  }
  .sc-limits ul {
    display: grid;
    gap: 0.875rem;
    padding: 0;
    list-style: none;
  }
  .sc-limits li {
    position: relative;
    padding-inline-start: 1.25rem;
    color: var(--sc-text);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .sc-limits li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0.125rem;
    top: 0.6em;
    width: 0.5rem;
    height: 1.5px;
    background: var(--sc-muted);
  }
  @media (min-width: 64rem) {
    .sc-trust {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 4rem;
    }
  }

  /* ---------- FAQ ---------- */
  .sc-faq {
    display: grid;
    gap: 2rem;
  }
  .sc-faq-head {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    justify-items: start;
  }
  .sc-faq-list {
    border-top: 1px solid var(--sc-border);
  }
  details {
    border-bottom: 1px solid var(--sc-border);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.125rem 0;
    color: var(--sc-ink);
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: color-mix(in srgb, var(--sc-ink) 75%, var(--sc-bg));
  }
  summary :global(.sc-faq-caret) {
    flex: none;
    color: var(--sc-muted);
    transition: transform 0.2s ease;
  }
  details[open] summary :global(.sc-faq-caret) {
    transform: rotate(180deg);
  }
  details p {
    max-width: 62ch;
    padding-bottom: 1.25rem;
    color: var(--sc-muted);
    line-height: 1.6;
  }
  @media (min-width: 64rem) {
    .sc-faq {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: 4rem;
    }
  }

  /* ---------- Closing call ---------- */
  .sc-cta {
    padding-top: 0;
  }
  .sc-rule {
    height: 1px;
    margin: 0 0 var(--sc-section);
    border: 0;
    background: var(--sc-border);
  }
  .sc-cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }
  .sc-cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
</style>
