---
// Footer of the landing and download pages: logo + one line, three link columns, language and
// theme (the same "starlight-theme" setting the guide pages use).
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { links } from '../brand.mjs';
import { copy } from '../lib/copy';
import { pagePath, tr, type SiteLang } from '../lib/i18n';

interface Props {
  lang: SiteLang;
}
const { lang } = Astro.props;
const f = copy[lang].footer;
const p = (slug: string) => pagePath(lang, slug);
const columns = [
  {
    title: f.product,
    links: [
      { label: f.links.download, href: p('download') },
      { label: f.links.guide, href: p('guide') },
      { label: f.links.viewers, href: p('viewers') },
      { label: f.links.updates, href: p('app/updates') },
    ],
  },
  {
    title: f.help,
    links: [
      { label: f.links.troubleshooting, href: p('help/troubleshooting') },
      { label: f.links.security, href: p('live/protection') },
      { label: f.links.askHelp, href: links.issues },
    ],
  },
  {
    title: f.project,
    links: [
      { label: f.links.source, href: links.repo },
      { label: f.links.privacy, href: p('about/privacy') },
      { label: f.links.developers, href: p('developers') },
      { label: f.links.license, href: links.license },
    ],
  },
];
const other = lang === 'en' ? 'pt-BR' : 'en';
---

<footer class="sc-footer">
  <div class="sc-container">
    <div class="sc-footer-top">
      <div class="sc-footer-brand">
        <Logo />
        <p>{f.tagline}</p>
      </div>
      {
        columns.map((c) => (
          <nav aria-label={c.title}>
            <h2>{c.title}</h2>
            <ul>
              {c.links.map((l) => (
                <li>
                  <a href={l.href} rel={l.href.startsWith('http') ? 'noopener' : undefined}>
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
    <div class="sc-footer-bottom">
      <p>{f.legal}</p>
      <div class="sc-footer-prefs">
        <a href={pagePath(other)} hreflang={other} lang={other} class="sc-footer-lang">
          <Icon name="globe" size={16} />
          {tr(lang, 'lang.switch')}
        </a>
        <label class="sc-theme">
          <span class="sc-sr-only">{tr(lang, 'theme.label')}</span>
          <Icon name="sun" size={16} />
          <select data-theme-select>
            <option value="auto">{tr(lang, 'theme.auto')}</option>
            <option value="light">{tr(lang, 'theme.light')}</option>
            <option value="dark">{tr(lang, 'theme.dark')}</option>
          </select>
          <Icon name="chevron" size={14} class="sc-theme-caret" />
        </label>
      </div>
    </div>
  </div>
</footer>

<script>
  const KEY = 'starlight-theme';
  for (const select of document.querySelectorAll<HTMLSelectElement>('[data-theme-select]')) {
    let stored = '';
    try {
      stored = localStorage.getItem(KEY) ?? '';
    } catch {}
    select.value = stored === 'light' || stored === 'dark' ? stored : 'auto';
    select.addEventListener('change', () => {
      const v = select.value;
      try {
        localStorage.setItem(KEY, v === 'auto' ? '' : v);
      } catch {}
      const light = window.matchMedia('(prefers-color-scheme: light)').matches;
      document.documentElement.dataset.theme = v === 'auto' ? (light ? 'light' : 'dark') : v;
    });
  }
</script>

<style>
  .sc-footer {
    border-top: 1px solid var(--sc-border);
    padding-block: var(--sc-space-8) var(--sc-space-6);
    font-size: var(--sc-text-small);
  }
  .sc-footer-top {
    display: grid;
    gap: var(--sc-space-6) var(--sc-space-5);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .sc-footer-brand {
    grid-column: 1 / -1;
    display: grid;
    gap: 0.75rem;
    align-content: start;
    max-width: 18rem;
  }
  .sc-footer-brand p {
    color: var(--sc-muted);
  }
  h2 {
    margin-bottom: 0.75rem;
    font-size: var(--sc-text-small);
    font-weight: 600;
  }
  ul {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }
  ul a {
    color: var(--sc-muted);
    text-decoration: none;
  }
  ul a:hover {
    color: var(--sc-ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .sc-footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: var(--sc-space-7);
    padding-top: var(--sc-space-5);
    border-top: 1px solid var(--sc-border);
    color: var(--sc-muted);
  }
  .sc-footer-prefs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .sc-footer-lang,
  .sc-theme {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.25rem;
    padding: 0 0.75rem;
    border: 1px solid var(--sc-border);
    border-radius: var(--sc-radius-sm);
    color: var(--sc-muted);
    text-decoration: none;
  }
  .sc-footer-lang:hover,
  .sc-theme:hover {
    color: var(--sc-ink);
    border-color: var(--sc-border-strong);
  }
  .sc-theme {
    padding-inline-end: 0.5rem;
  }
  .sc-theme select {
    appearance: none;
    padding: 0 1.25rem 0 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .sc-theme select:focus-visible {
    outline: none;
  }
  .sc-theme:focus-within {
    outline: 2px solid var(--sc-focus);
    outline-offset: 2px;
  }
  .sc-theme :global(.sc-theme-caret) {
    position: absolute;
    inset-inline-end: 0.5rem;
    pointer-events: none;
  }
  @media (min-width: 48rem) {
    .sc-footer-top {
      grid-template-columns: 2fr repeat(3, minmax(0, 1fr));
    }
    .sc-footer-brand {
      grid-column: auto;
    }
  }
</style>
