---
// A real screenshot in a clean app-window frame: 1 px border, a neutral title bar, no tilt, no
// glow. `crop` (width / height) shows only the top of a tall screenshot.
import { Image } from 'astro:assets';
import { brand } from '../brand.mjs';

interface Props {
  src: ImageMetadata;
  alt: string;
  title?: string;
  crop?: number;
  widths?: number[];
  sizes?: string;
  eager?: boolean;
}
const { src, alt, title = brand.name, crop, widths = [640, 960, 1280], sizes = '(min-width: 72rem) 70rem, 100vw', eager = false } = Astro.props;
---

<figure class="sc-frame">
  <div class="sc-frame-bar" aria-hidden="true">
    <span class="sc-frame-dots"><i></i><i></i><i></i></span>
    <span class="sc-frame-title">{title}</span>
    <span class="sc-frame-dots sc-frame-spacer"></span>
  </div>
  <div class="sc-frame-shot" style={crop ? `aspect-ratio: ${crop}` : undefined}>
    <Image src={src} alt={alt} widths={widths.filter((w) => w <= src.width)} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
  </div>
</figure>

<style>
  .sc-frame {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--sc-border-strong);
    border-radius: var(--sc-radius-lg);
    background: var(--sc-surface);
    box-shadow: var(--sc-shadow);
  }
  .sc-frame-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 2.25rem;
    padding: 0 0.875rem;
    border-bottom: 1px solid var(--sc-border);
    background: var(--sc-surface);
  }
  .sc-frame-dots {
    display: flex;
    gap: 0.375rem;
    width: 3.5rem;
  }
  .sc-frame-dots i {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--sc-border-strong);
  }
  .sc-frame-title {
    color: var(--sc-muted);
    font-size: var(--sc-text-micro);
    font-weight: 500;
  }
  .sc-frame-shot {
    overflow: hidden;
    background: var(--sc-surface);
  }
  .sc-frame-shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  /* Phones: a legible close-up of the top-left of the screenshot instead of a tiny whole. */
  @media (max-width: 39.99rem) {
    .sc-frame-shot {
      aspect-ratio: 4 / 3.4 !important;
    }
    .sc-frame-shot :global(img) {
      width: 165%;
      max-width: none;
      /* The panel screenshot has an empty margin on the left: skip it. */
      margin-inline-start: -12%;
      height: auto;
      object-fit: initial;
    }
  }
</style>
