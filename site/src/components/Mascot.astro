---
// The mascot, when `brand.mascot` is set in src/brand.mjs (file in assets/brand/ at the repo
// root). Renders nothing until then: no placeholder clip art.
import { Image } from 'astro:assets';
import { brand } from '../brand.mjs';
import type { SiteLang } from '../lib/i18n';

interface Props {
  lang: SiteLang;
  width?: number;
  eager?: boolean;
}
const { lang, width = 160, eager = false } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../../../assets/brand/**/*.{png,jpg,jpeg,webp,svg,avif}', { eager: true });
const file = brand.mascot ? files[`../../../assets/brand/${brand.mascot.file}`]?.default : undefined;
---

{file && <Image class="sc-mascot" src={file} alt={brand.mascot?.alt[lang] ?? ''} width={width} loading={eager ? 'eager' : 'lazy'} style={`--w: ${width}px`} />}

<style>
  .sc-mascot {
    width: min(var(--w, 160px), 40vw);
    height: auto;
    margin-inline: auto;
  }
</style>
