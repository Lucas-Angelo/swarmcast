---
// OBS -> SwarmCast on your PC -> secret link -> members' browsers. An ordered list, so screen
// readers read it as four steps. Four columns on wide screens, a vertical list on phones.
import Icon from './Icon.astro';
import { tr, type SiteLang } from '../lib/i18n';

interface Props {
  lang: SiteLang;
}
const { lang } = Astro.props;
const steps = [
  { icon: 'record', title: tr(lang, 'flow.obs'), text: tr(lang, 'flow.obs.d') },
  { icon: 'monitor', title: tr(lang, 'flow.app'), text: tr(lang, 'flow.app.d') },
  { icon: 'link', title: tr(lang, 'flow.link'), text: tr(lang, 'flow.link.d') },
  { icon: 'users', title: tr(lang, 'flow.viewers'), text: tr(lang, 'flow.viewers.d') },
];
---

<ol class="sc-flow" aria-label={tr(lang, 'flow.label')} data-testid="how-it-works">
  {
    steps.map((s, i) => (
      <li>
        <div class="sc-flow-top">
          <span class="sc-flow-icon">
            <Icon name={s.icon} size={20} />
          </span>
          <span class="sc-flow-num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
        </div>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .sc-flow {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--sc-border);
    border-radius: var(--sc-radius-lg);
    background: var(--sc-border);
    overflow: hidden;
  }
  li {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1.5rem;
    background: var(--sc-surface);
  }
  .sc-flow-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }
  .sc-flow-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--sc-radius);
    background: var(--sc-accent-soft);
    color: var(--sc-accent-strong);
  }
  .sc-flow-num {
    color: var(--sc-muted);
    font-size: var(--sc-text-micro);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }
  h3 {
    font-size: var(--sc-text-h3);
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  p {
    color: var(--sc-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  /* Phones: a compact row per step, icon on the left. */
  @media (max-width: 39.99rem) {
    li {
      grid-template-columns: auto 1fr;
      column-gap: 1rem;
      row-gap: 0.25rem;
      padding: 1.25rem;
    }
    .sc-flow-top {
      grid-row: span 2;
      align-self: start;
      margin: 0;
    }
    .sc-flow-num {
      display: none;
    }
  }
  @media (min-width: 40rem) {
    .sc-flow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .sc-flow {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    li {
      padding: 1.75rem;
    }
  }
</style>
